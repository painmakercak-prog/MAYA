# Nomi is the conversational brain and persistent relationship context.
# IMPORTANT: create a fresh key; never reuse a key exposed in a screenshot/chat.
NOMI_API_KEY=your_fresh_nomi_api_key

# Speech-to-text
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en

# Text-to-speech
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_VOICE_ID=your_cartesia_voice_uuid
CARTESIA_MODEL_ID=sonic-3.6
CARTESIA_VERSION=2026-08-14

# Railway supplies PORT automatically. Local default is 8000.
# PORT=8000
