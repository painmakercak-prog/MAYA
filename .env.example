# Required by your Cartesia deployment/runtime
CARTESIA_API_KEY=your_cartesia_key

# LLM
# Default model if omitted:
# anthropic/claude-haiku-4-5-20251001
LLM_MODEL=anthropic/claude-haiku-4-5-20251001
LLM_API_KEY=your_model_provider_key

# Long-term memory
SUPERMEMORY_API_KEY=your_supermemory_key

# Character
COMPANION_NAME=Maya
USER_NAME=Kasey

# Use one stable tag for this person/relationship across calls.
MEMORY_CONTAINER_TAG=companion-primary

# Optional tuning
MEMORY_SEARCH_LIMIT=8
MEMORY_SEARCH_THRESHOLD=0.20

# Optional spoken intro. Leave blank if Cartesia handles greeting elsewhere.
INTRODUCTION=
